# PRIME H₂O server configuration. Copy to server/.env for local development, or set these on
# your hosting provider. Never commit real values. Real environment variables override this file.

APP_ENV=development              # development | production (production forces Secure cookies)
PORT=8787
FRONTEND_URL=                    # website address, e.g. https://www.primeh2o.in. Used for CORS and
                                 # for the dashboard link in owner emails. Leave empty when the
                                 # website is served by this server (npm start) or the Vite dev proxy.

# ---------------------------------------------------------------- database (PostgreSQL)
# Local:  postgres://prime:<password>@127.0.0.1:5433/primeh2o   with DATABASE_SSL empty
# Neon:   use the DIRECT connection string (not the "-pooler" one) with DATABASE_SSL=true
DATABASE_URL=
DATABASE_SSL=                    # true (verified TLS) | no-verify | empty (no TLS, local only)

# ---------------------------------------------------------------- admin accounts
# Accounts live in the database. Create them with:   npm run admin:create -- owner@example.com "Owner Name"
# Or let the server create/update the owner at startup from these two (hash from: npm run admin:hash):
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=             # scrypt hash, never a plain password
ADMIN_NAME=PRIME H₂O Owner
# Signs API Bearer tokens (JWT) returned by POST /api/admin/login. At least 32 random characters,
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=
ADMIN_SESSION_HOURS=12

# ---------------------------------------------------------------- Meta WhatsApp Business Cloud API
# Every order event notifies owner AND customer by WhatsApp using approved templates
# (list / submit them: npm run whatsapp:templates). Customers only get WhatsApp if they opted in.
WHATSAPP_ACCESS_TOKEN=           # System User token: whatsapp_business_messaging + whatsapp_business_management
WHATSAPP_PHONE_NUMBER_ID=        # ID of the SENDER number registered on the Cloud API
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=                 # Meta app secret: verifies webhook signatures
WHATSAPP_WEBHOOK_VERIFY_TOKEN=   # webhook URL: https://<domain>/api/webhooks/whatsapp (subscribe to "messages")
PRIME_H2O_BUSINESS_WHATSAPP=918143489222   # company WhatsApp that receives every new-order alert: digits with
                                           # country code; must differ from the sender number above
                                           # (WHATSAPP_OWNER_NUMBER is the older name and still works)
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0                 # Graph API version (WHATSAPP_GRAPH_VERSION is the older name and still works)

# ---------------------------------------------------------------- Brevo (transactional email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=              # must be a verified sender in Brevo
BREVO_SENDER_NAME=PRIME H₂O
BREVO_SANDBOX=false              # true = Brevo validates every email but does not deliver it (testing)
BREVO_WEBHOOK_TOKEN=             # random string; webhook URL: https://<domain>/api/webhooks/brevo?token=<this>
BUSINESS_EMAIL=prime2417@gmail.com   # where owner emails go

# ---------------------------------------------------------------- optional
TRUST_PROXY=                     # true when behind a reverse proxy / load balancer (Render: true)
ALLOWED_ORIGINS=                 # extra comma-separated origins allowed to POST /api/orders and /api/enquiries
ENQUIRY_RATE_LIMIT=8             # submissions per IP address per 10 minutes
PUBLIC_SITE_URL=                 # overrides FRONTEND_URL for the dashboard link in owner emails
